# Copy to .env (gitignored) and fill in the keys you have. Never commit .env.
# Provider is picked from LLM_PROVIDER, else the first key set below.
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
# Any other OpenAI-compatible server: LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_API_KEY=
