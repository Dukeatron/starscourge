# Copy to .env (gitignored) and fill in the keys you have. Never commit .env.
# Provider order: the request's X-LLM-Provider, else the prefix of a key sent with the request,
# else LLM_PROVIDER, else local Ollama (smallest installed model, no key). There is no
# auto-detection from the keys below: a key here is used only when its provider is selected.
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
# Any other OpenAI-compatible server: LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_API_KEY=
# Offline demo mode: replay recorded findings for the bundled samples, no LLM (see README)
AI_ENGINE_DEMO=
